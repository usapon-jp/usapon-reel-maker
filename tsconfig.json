{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "es2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./apps/web/*"],
      "@usapon-reel/core": ["./packages/core/src/index.ts"],
      "@usapon-reel/local": ["./packages/local/src/index.ts"],
      "@usapon-reel/renderer": ["./packages/renderer/src/composition.tsx"],
      "@usapon-reel/renderer/server": ["./packages/renderer/src/server.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
