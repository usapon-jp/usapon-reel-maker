{
  "name": "usapon-reel-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"npm run dev -w @usapon-reel/web\" \"npm run dev -w @usapon-reel/worker\"",
    "dev:web": "npm run dev -w @usapon-reel/web",
    "dev:worker": "npm run dev -w @usapon-reel/worker",
    "cloud:worker": "npm run start -w @usapon-reel/worker",
    "build": "npm run build -w @usapon-reel/web",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"npm run start -w @usapon-reel/web\" \"npm run start -w @usapon-reel/worker\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:output": "node --import tsx scripts/verify-output.ts"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
